{
  "name": "dvelop-smartinvoice-types",
  "version": "0.0.4",
  "description": "TypeScript types and Zod schemas for d.velop smart invoice payloads.",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Paperless-Solutions-GmbH/dvelop-smartinvoice-types.git"
  },
  "author": "pplsjannik",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "check": "tsc --noEmit",
    "prepublishOnly": "npm run check && npm run build"
  },
  "keywords": [
    "dvelop",
    "smartinvoice",
    "zod",
    "typescript"
  ],
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.9.2"
  }
}
